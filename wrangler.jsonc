{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers Builds deploys this repository to the Worker of this name.
  "name": "allenhansen-dev",
  "compatibility_date": "2026-10-14",
  // Production also answers on allenhansen-dev.<subdomain>.workers.dev, and each
  // version and branch Preview gets its own URL. Wrangler leaves either setting
  // alone when the field is missing, so both are set explicitly.
  "workers_dev": true,
  "preview_urls": true,
  // www.allenhansen.dev is a Custom Domain: Cloudflare manages its DNS record and
  // certificate. `wrangler deploy` makes the Worker's routes match this list, so a
  // route or domain added only in the dashboard is removed on the next deploy. The
  // apex and http:// redirects are zone rules, not part of this Worker.
  "routes": [{ "pattern": "www.allenhansen.dev", "custom_domain": true }],
  // Wrangler runs this before deploy, preview, versions upload, and dev, so dist/
  // exists even when the Workers Builds build command is empty.
  "build": {
    "command": "pnpm build",
    // Watch the sources, not the repo root: the build writes to dist/ there,
    // which would set off another build.
    "watch_dir": ["src", "public"],
  },
  // No Worker script: every response is a static file from the Astro build.
  // _redirects and _headers in dist/ (from public/ and the build) add the rest.
  "assets": {
    "directory": "./dist",
    // /blog/x/index.html is served at /blog/x/, and /blog/x redirects there.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  // Required by `wrangler preview`, which Workers Builds runs for branches other
  // than production. It's empty: the site has no bindings or variables to swap.
  "previews": {},
}
