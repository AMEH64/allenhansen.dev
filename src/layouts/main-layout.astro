---
import BaseHead from '~/components/base-head.astro'
import Footer from '~/components/footer.astro'
import Header from '~/components/header.astro'
import LightEngine from '~/components/light-engine.astro'
import Paper from '~/components/paper.astro'

type Props = {
  title: string
  description: string
  ogImage?: string
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  /** Marks the matching header or footer link as the current page. */
  current?: string
  bodyClass?: string
}

const { current, bodyClass, ...head } = Astro.props
---

<!doctype html>
<html
  lang="en"
  class="bg-paper font-sans text-[17px] leading-[1.6] text-text transition-[background-color,color] duration-600 ease-[ease] phone:text-[16px]"
>
  <head>
    <BaseHead {...head} />
  </head>
  <body class:list={['relative min-h-screen overflow-x-hidden', bodyClass]}>
    <a
      class="absolute -top-60 left-12 z-50 rounded-xs bg-text px-14 py-8 text-paper focus:top-12 print:hidden"
      href="#main">Skip to content</a
    >
    <Paper />
    <div
      class="relative z-1 mx-auto max-w-1240 px-48 print:in-[.page-resume]:max-w-none print:in-[.page-resume]:p-0! phone:px-20"
    >
      <Header current={current} />
      <main id="main">
        <slot />
      </main>
      <Footer current={current} />
    </div>
    <LightEngine />
  </body>
</html>
