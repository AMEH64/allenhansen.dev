---
import BaseHead from '~/components/base-head.astro'
import Footer from '~/components/footer.astro'
import Header from '~/components/header.astro'
import LightEngine from '~/components/light-engine.astro'
import Paper from '~/components/paper.astro'

type Props = {
  title: string
  description: string
  ogImage?: string
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  /** Marks the matching header or footer link as the current page. */
  current?: string
  bodyClass?: string
}

const { current, bodyClass, ...head } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <Paper />
    <div class="wrap">
      <Header current={current} />
      <main id="main">
        <slot />
      </main>
      <Footer current={current} />
    </div>
    <LightEngine />
  </body>
</html>
