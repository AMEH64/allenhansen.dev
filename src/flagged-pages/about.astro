---
// Two photos: a portrait beside the opener, and Boba full width between sections.
import { SITE_TITLE } from '~/consts'
import AboutNew from '~/copy/about-new.astro'
import AboutOld from '~/copy/about-old.astro'
import { features } from '~/config/features'
import PageTitle from '~/components/page-title.astro'
import PhotoPlate from '~/components/photo-plate.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { rssPath } from '~/lib/posts'
import { links, meta } from '~/site.config'
import portrait from '~/assets/images/allen/allen-portrait.jpg'
import bobaWide from '~/assets/images/boba/boba-wide.jpg'

const AboutCopy = features.aboutCopy === 'old' ? AboutOld : AboutNew
const glanceRow =
  'grid grid-cols-[64px_minmax(0,1fr)] gap-2.5 border-b border-rule py-2 text-[14.5px] leading-[1.45]'
const glanceTerm =
  'pt-0.5 font-mono text-[11px] tracking-widest text-muted uppercase'
const colophonHead =
  'mb-2 text-[13px] font-semibold tracking-[0.08em] text-muted uppercase before:mr-2.5 before:font-mono before:text-brand before:content-[counter(col,decimal-leading-zero)]'
const colophonText = 'text-[15px] leading-[1.55] text-muted'
---

<MainLayout
  title={`About · ${SITE_TITLE}`}
  description={meta.about}
  ogImage="/og/about.png"
  current="about"
>
  <PageTitle title="About" />
  <div
    class="grid grid-cols-[minmax(0,640px)_300px] gap-20 pb-10 phone:grid-cols-[minmax(0,1fr)] phone:gap-10"
  >
    <div class="prose">
      <AboutCopy />
      <ul
        class="mt-[22px] flex list-none flex-wrap gap-6 p-0 *:mt-0 [&_a]:font-mono [&_a]:text-[14px]"
        aria-label="Contact and elsewhere"
      >
        <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
        <li><a href={links.github}>GitHub</a></li>
        <li><a href={links.linkedin}>LinkedIn</a></li>
        <li><a href={rssPath}>RSS</a></li>
        <li><a href="/resume/">Résumé</a></li>
      </ul>
    </div>
    <div>
      <PhotoPlate
        src={portrait}
        alt="Allen smiling in glasses and a light linen shirt, with trees softly out of focus behind him."
        shape="portrait"
      />
      <section
        class="mt-9 border-t-2 border-brand pt-3"
        aria-labelledby="glance-h"
      >
        <h2
          class="mb-1 font-mono text-[11.5px] font-semibold tracking-[0.16em] text-brand uppercase"
          id="glance-h"
        >
          At a glance
        </h2>
        <dl>
          <div class={glanceRow}>
            <dt class={glanceTerm}>Role</dt><dd>Senior full-stack engineer</dd>
          </div>
          <div class={glanceRow}>
            <dt class={glanceTerm}>Now</dt><dd>
              Schneider Electric Sustainability Business
            </dd>
          </div>
          <div class={glanceRow}>
            <dt class={glanceTerm}>Since</dt><dd>
              2017, from Web Forms to React
            </dd>
          </div>
          <div class={glanceRow}>
            <dt class={glanceTerm}>Lately</dt><dd>Python, FastAPI, MCP</dd>
          </div>
          <div class={glanceRow}>
            <dt class={glanceTerm}>More</dt><dd>
              <a href="/resume/">The full résumé →</a>
            </dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
  <PhotoPlate
    src={bobaWide}
    alt="Allen sits in the grass with an arm around Boba, a black dog with a white chest and a collar, and smiles down at him."
    caption="Boba and me"
    shape="wide"
  />
  <section
    class="relative grid grid-cols-[repeat(2,1fr)] gap-7 pt-[30px] pb-10 [counter-reset:col] phone:grid-cols-[1fr]"
    aria-label="Colophon"
  >
    <span class="absolute inset-x-0 top-0 rule"></span>
    <div class="[counter-increment:col]">
      <h2 class={colophonHead}>Readable first</h2>
      <p class={colophonText}>
        Body type is Atkinson Hyperlegible, designed for low vision.
      </p>
    </div>
    <div class="[counter-increment:col]">
      <h2 class={colophonHead}>Posts stay honest</h2>
      <p class={colophonText}>
        Every post shows when it was published and last updated. When something
        changes, I rewrite it in place and add a dated line to the change log,
        which links to the full history on GitHub.
      </p>
    </div>
  </section>
</MainLayout>
