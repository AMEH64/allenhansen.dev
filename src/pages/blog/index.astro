---
import { SITE_TITLE } from '~/consts'
import NoteRow from '~/components/note-row.astro'
import PageTitle from '~/components/page-title.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { getNotes, type Note } from '~/lib/notes'
import { meta } from '~/site.config'

const notes = await getNotes()
const years = Object.entries(
  notes.reduce<Record<string, Note[]>>((acc, note) => {
    ;(acc[note.data.date.slice(0, 4)] ||= []).push(note)
    return acc
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a))
---

<MainLayout
  title={`Blog · ${SITE_TITLE}`}
  description={meta.blog}
  ogImage="/og/blog.png"
  current="blog"
>
  <PageTitle
    title="Blog"
    lead="Things I’ve learned, written down so I don’t forget them."
  />
  {
    years.map(([year, list]) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`}>{year}</h2>
        <ul class="rows">
          {list.map(note => (
            <NoteRow note={note} />
          ))}
        </ul>
      </section>
    ))
  }
  <div style="height:40px"></div>
</MainLayout>
