---
import { getEntry, render } from 'astro:content'
import { SITE_TITLE } from '~/consts'
import ChangeLog from '~/components/change-log.astro'
import CodeCopy from '~/components/code-copy.astro'
import Anchor from '~/components/mdx/anchor.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { formatDate } from '~/lib/dates'
import {
  BLOG,
  getNotes,
  kindLabel,
  noteLog,
  postPath,
  readingMinutes,
  reportUrl,
  type Note,
} from '~/lib/notes'

export async function getStaticPaths() {
  const notes = await getNotes()
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }))
}

type Props = { note: Note; newer?: Note; older?: Note }

const { note, newer, older } = Astro.props
const { data } = note
const { Content, headings } = await render(note)
const log = noteLog(data)
const url = new URL(postPath(note.id), Astro.site).href
const toc = headings.filter(h => h.depth === 2)
const replacement = data.supersededBy
  ? await getEntry(data.supersededBy)
  : undefined
// reference() only warns about a missing entry, so fail the build here instead.
if (data.supersededBy && !replacement) {
  throw new Error(
    `${note.id}: supersededBy "${data.supersededBy.id}" isn't a note.`,
  )
}
const newerWay =
  replacement && (!replacement.data.draft || import.meta.env.DEV)
    ? replacement
    : undefined
---

<MainLayout
  title={`${data.title} · ${SITE_TITLE}`}
  description={data.summary}
  ogImage={`/og${BLOG}${note.id}.png`}
  type="article"
  publishedTime={data.date}
  modifiedTime={data.updatedDate ?? data.date}
  current="blog"
>
  <a class="crumb" href={BLOG}>← Blog</a>
  <header class="note-head">
    <h1 class="relief" data-lit>{data.title}</h1>
    <div class="note-meta">
      <span class="kind">{kindLabel[data.kind]}</span>
      <time datetime={data.date}>{formatDate(data.date)}</time>
      {
        data.updatedDate && (
          <span>
            Updated{' '}
            {log.length > 0 ? (
              <a href="#changes">
                <time datetime={data.updatedDate}>
                  {formatDate(data.updatedDate)}
                </time>
              </a>
            ) : (
              <time datetime={data.updatedDate}>
                {formatDate(data.updatedDate)}
              </time>
            )}
          </span>
        )
      }
      <span>{readingMinutes(note.body)} min read</span>
    </div>
  </header>
  <div class="note-grid">
    <article class="prose">
      {
        newerWay && (
          <p class="callout superseded">
            There’s a newer way to do this →{' '}
            <a href={postPath(newerWay.id)}>{newerWay.data.title}</a>
          </p>
        )
      }
      <Content components={{ a: Anchor }} />
      {log.length > 0 && <ChangeLog log={log} filePath={note.filePath} />}
      <p class="report">
        <a href={reportUrl(data.title, url)}
          >See something wrong or out of date? Open an issue →</a
        >
      </p>
      <CodeCopy />
    </article>
    {
      toc.length > 0 && (
        <aside class="margin" aria-label="On this page">
          <nav class="toc" aria-labelledby="toc-h">
            <h2 id="toc-h">On this page</h2>
            <ol>
              {toc.map(h => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
              {log.length > 0 && (
                <li>
                  <a href="#changes">Change log</a>
                </li>
              )}
            </ol>
          </nav>
        </aside>
      )
    }
  </div>
  {
    (older || newer) && (
      <nav class="pn" aria-label="More posts">
        <span class="rule" />
        {older && (
          <a href={postPath(older.id)}>
            <small>← Older</small>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a class="next" href={postPath(newer.id)}>
            <small>Newer →</small>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
</MainLayout>
