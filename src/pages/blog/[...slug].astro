---
import { getEntry, render } from 'astro:content'
import { SITE_TITLE } from '~/consts'
import ChangeLog from '~/components/change-log.astro'
import CodeCopy from '~/components/code-copy.astro'
import Anchor from '~/components/mdx/anchor.astro'
import PostTags from '~/components/post-tags.astro'
import { callout, postType } from '~/lib/classes'
import MainLayout from '~/layouts/main-layout.astro'
import { formatDate } from '~/lib/dates'
import {
  BLOG,
  getPosts,
  typeLabel,
  postLog,
  postPath,
  readingMinutes,
  reportUrl,
  type Post,
} from '~/lib/posts'

export async function getStaticPaths() {
  const notes = await getPosts()
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }))
}

type Props = { note: Post; newer?: Post; older?: Post }

const { note, newer, older } = Astro.props
const { data } = note
const { Content, headings } = await render(note)
const log = postLog(data)
const url = new URL(postPath(note.id), Astro.site).href
const toc = headings.filter(h => h.depth === 2)
const replacement = data.supersededBy
  ? await getEntry(data.supersededBy)
  : undefined
// reference() only warns about a missing entry, so fail the build here instead.
if (data.supersededBy && !replacement) {
  throw new Error(
    `${note.id}: supersededBy "${data.supersededBy.id}" isn't a note.`,
  )
}
const newerWay =
  replacement && (!replacement.data.draft || import.meta.env.DEV)
    ? replacement
    : undefined

const tocLink =
  'no-underline hover:text-text hover:underline hover:decoration-brand hover:decoration-auto'
const pnLink =
  'text-[17px] font-[520] no-underline hover:underline hover:decoration-brand hover:decoration-auto'
const pnLabel = 'mb-1 block text-[12.5px] font-normal text-muted'
---

<MainLayout
  title={`${data.title} · ${SITE_TITLE}`}
  description={data.summary}
  ogImage={`/og${BLOG}${note.id}.png`}
  type="article"
  publishedTime={data.date}
  modifiedTime={data.updatedDate ?? data.date}
  current="blog"
>
  <a class="text-[14px] text-muted no-underline hover:text-text" href={BLOG}
    >← Blog</a
  >
  <header class="max-w-[900px] pt-[18px] pb-[30px]">
    <h1
      class="mt-3.5 mb-[18px] font-display text-[50px] leading-[1.04] font-extrabold tracking-[-0.01em] text-balance relief [font-variation-settings:'wdth'_112] phone:text-[32px]"
      data-lit
    >
      {data.title}
    </h1>
    <div class="flex flex-wrap items-center gap-[18px] text-[14px] text-muted">
      <span class={postType}>{typeLabel[data.type]}</span>
      <time datetime={data.date}>{formatDate(data.date)}</time>
      {
        data.updatedDate && (
          <span>
            Updated{' '}
            {log.length > 0 ? (
              <a href="#changes">
                <time datetime={data.updatedDate}>
                  {formatDate(data.updatedDate)}
                </time>
              </a>
            ) : (
              <time datetime={data.updatedDate}>
                {formatDate(data.updatedDate)}
              </time>
            )}
          </span>
        )
      }
      <span>{readingMinutes(note.body)} min read</span>
    </div>
    <PostTags class="mt-3.5" tags={data.tags} />
  </header>
  <div
    class="grid grid-cols-[minmax(0,680px)_280px] gap-18 pb-10 phone:grid-cols-[minmax(0,1fr)] phone:gap-10"
  >
    <article class="prose">
      {
        newerWay && (
          <p class:list={[callout, 'mt-0 mb-[1.6em] border-l-3']}>
            There’s a newer way to do this →{' '}
            <a href={postPath(newerWay.id)}>{newerWay.data.title}</a>
          </p>
        )
      }
      <Content components={{ a: Anchor }} />
      {log.length > 0 && <ChangeLog log={log} filePath={note.filePath} />}
      <p class="mt-[22px] text-[14.5px] leading-[1.5] print:hidden">
        <a
          class="font-mono text-[13.5px] tracking-[0.02em]"
          href={reportUrl(data.title, url)}
          >See something wrong or out of date? Open an issue →</a
        >
      </p>
      <CodeCopy />
    </article>
    {
      toc.length > 0 && (
        <aside
          class="text-[14px] leading-[1.55] text-muted"
          aria-label="On this page"
        >
          <nav aria-labelledby="toc-h">
            <h2
              class="mb-2.5 text-[12px] font-semibold tracking-[0.1em] uppercase"
              id="toc-h"
            >
              On this page
            </h2>
            <ol class="*:relative *:py-2">
              {toc.map(h => (
                <li>
                  <a class={tocLink} href={`#${h.slug}`}>
                    {h.text}
                  </a>
                </li>
              ))}
              {log.length > 0 && (
                <li>
                  <a class={tocLink} href="#changes">
                    Change log
                  </a>
                </li>
              )}
            </ol>
          </nav>
        </aside>
      )
    }
  </div>
  {
    (older || newer) && (
      <nav
        class="relative grid grid-cols-[1fr_1fr] gap-[30px] pt-[30px] pb-[50px]"
        aria-label="More posts"
      >
        <span class="absolute inset-x-0 top-0 rule" />
        {older && (
          <a class={pnLink} href={postPath(older.id)}>
            <small class={pnLabel}>← Older</small>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a
            class:list={[pnLink, 'col-start-2 text-right']}
            href={postPath(newer.id)}
          >
            <small class={pnLabel}>Newer →</small>
            {newer.data.title}
          </a>
        )}
      </nav>
    )
  }
</MainLayout>
