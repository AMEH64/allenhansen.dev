---
import { SITE_TITLE } from '~/consts'
import Anchor from '~/components/mdx/anchor.astro'
import PageTitle from '~/components/page-title.astro'
import PhotoPlate from '~/components/photo-plate.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { meta, now } from '~/site.config'
import park from '~/assets/images/park/allen-in-the-park.jpg'

const section = 'relative pt-[18px] pb-[26px]'
const heading =
  'mb-2.5 font-mono text-[12px] font-semibold tracking-[0.16em] text-brand uppercase'
---

<MainLayout
  title={`Now · ${SITE_TITLE}`}
  description={meta.now}
  ogImage="/og/now.png"
  current="now"
>
  <PageTitle
    title="Now"
    lead={`What I’d tell a friend I hadn’t seen in a year. Last updated ${now.updated}.`}
  />
  <PhotoPlate
    class="max-w-[900px]"
    src={park}
    alt="Allen standing in a sunny park, looking off to the side, with trees and grass behind him."
    shape="wide"
    imageClass="object-[50%_15%]"
    sizes="(max-width: 760px) calc(100vw - 40px), 900px"
    loading="eager"
  />
  <div
    class="grid max-w-[900px] grid-cols-2 gap-x-14 gap-y-2.5 pb-[30px] phone:grid-cols-[1fr]"
  >
    <section class={section} aria-labelledby="now-work">
      <span class="absolute inset-x-0 top-0 rule"></span>
      <h2 class={heading} id="now-work">Working on</h2>
      <div class="prose text-[17px]">
        <ul>
          <li>
            Resource Advisor+ at Schneider Electric, an AI-native platform for
            energy and sustainability. I build its agentic experiences, from the
            agents themselves to the platform, tooling and harness behind them.
          </li>
          <li>
            Day to day: Python and FastAPI, C# and .NET, Angular, Tailwind CSS,
            Kubernetes, and AI-assisted development.
          </li>
        </ul>
      </div>
    </section>
    <section class={section} aria-labelledby="now-side">
      <span class="absolute inset-x-0 top-0 rule"></span>
      <h2 class={heading} id="now-side">Side projects</h2>
      <div class="prose text-[17px]">
        <ul>
          <li>
            <Anchor href="https://verso.allenhansen.dev">Verso</Anchor>, a
            flash-card app for learning languages.
          </li>
          <li>This site.</li>
        </ul>
      </div>
    </section>
  </div>
  <p class="max-w-[640px] pb-6 text-[17px]">Away from work: walks with Boba.</p>
  <p class="max-w-[640px] pb-10 text-[15px] text-muted">
    Inspired by the <a href="https://nownownow.com/about">/now movement</a>.
    Want to know more? <a href="/about/">See the about page →</a>
  </p>
</MainLayout>
