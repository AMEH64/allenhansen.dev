---
import { SITE_TITLE } from '~/consts'
import PageTitle from '~/components/page-title.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { meta, now } from '~/site.config'
---

<MainLayout
  title={`Now · ${SITE_TITLE}`}
  description={meta.now}
  ogImage="/og/now.png"
  current="now"
>
  <PageTitle
    title="Now"
    lead={`What I’d tell a friend I hadn’t seen in a year. Last updated ${now.updated}.`}
  />
  <div class="now-grid">
    <section aria-labelledby="now-work">
      <span class="rule"></span>
      <h2 id="now-work">Working on</h2>
      <div class="prose">
        <ul>
          <li>
            Building and shipping features on a production web application at my
            day job
          </li>
          <li>
            This site: rebuilt as a letterpress proof sheet, with notes that say
            when I last checked them
          </li>
        </ul>
      </div>
    </section>
    <section aria-labelledby="now-learning">
      <span class="rule"></span>
      <h2 id="now-learning">Learning</h2>
      <div class="prose">
        <ul>
          <li>Mandarin, drilling HSK 3 in Verso</li>
          <li>
            <span lang="haw">ʻŌlelo Hawaiʻi</span>, through hula vocabulary
          </li>
          <li>Python, FastAPI, and the Model Context Protocol</li>
        </ul>
      </div>
    </section>
    <section aria-labelledby="now-reading">
      <span class="rule"></span>
      <h2 id="now-reading">Reading &amp; watching</h2>
      <div class="prose">
        <ul>
          <li><em>A Philosophy of Software Design</em>, John Ousterhout</li>
          <li>
            Conference talks on TypeScript compiler internals and performance
          </li>
        </ul>
      </div>
    </section>
    <section aria-labelledby="now-side">
      <span class="rule"></span>
      <h2 id="now-side">Side projects</h2>
      <div class="prose">
        <ul>
          <li>
            <a href="https://verso.allenhansen.dev">Verso</a>: flash cards for
            Chinese and <span lang="haw">ʻŌlelo Hawaiʻi</span>
          </li>
          <li>This site: the design, content, and tooling are ongoing work</li>
        </ul>
      </div>
    </section>
  </div>
  <p class="now-foot">
    Inspired by the <a href="https://nownownow.com/about">/now movement</a>.
    Want to know more? <a href="/about/">See the about page →</a>
  </p>
</MainLayout>
