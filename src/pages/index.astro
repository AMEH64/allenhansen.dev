---
import { SITE_TITLE } from '~/consts'
import Anchor from '~/components/mdx/anchor.astro'
import PostRow from '~/components/post-row.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { BLOG, getPosts } from '~/lib/posts'
import { displayUrl, getProjects, statusLabel } from '~/lib/projects'
import { features } from '~/config/features'
import { meta, now } from '~/site.config'

const notes = await getPosts()
const projects = (await getProjects()).slice(0, 3)
---

<MainLayout title={SITE_TITLE} description={meta.index} ogImage="/og/index.png">
  <section class="hero" aria-labelledby="hero-h">
    <span class="crop tl" aria-hidden="true"></span><span
      class="crop tr"
      aria-hidden="true"></span><span class="crop bl" aria-hidden="true"
    ></span><span class="crop br" aria-hidden="true"></span>
    <p class="slug-line">Blog &amp; projects · Full-stack engineering</p>
    <h1 class="vh" id="hero-h">Allen Hansen</h1>
    <div class="emboss hero-name" data-lit aria-hidden="true">
      <span>Allen</span><span>Hansen</span>
    </div>
    <div class="intro">
      <p>
        Full-stack engineer. I write down what I learn, and I build small things
        that each get their own address.
      </p>
    </div>
  </section>

  <div class="home-cols">
    <section aria-labelledby="h-lately">
      <h2 class="sec-h" id="h-lately">
        Lately <a href={BLOG}>All {notes.length} posts →</a>
      </h2>
      <span class="rule"></span>
      <ul class="rows">
        {notes.slice(0, 3).map(note => <PostRow note={note} />)}
      </ul>
    </section>
    <section aria-labelledby="h-projects">
      <h2 class="sec-h" id="h-projects">
        Projects <a href="/projects/">All projects →</a>
      </h2>
      <span class="rule"></span>
      <ul class="rows proj-rows">
        {
          projects.map(({ data: p }) => (
            <li>
              <span class={`pdot st-${p.status}`} aria-hidden="true" />
              <span>
                {p.url ? (
                  <Anchor class="t" href={p.url}>
                    {p.name}
                  </Anchor>
                ) : (
                  <span class="t">{p.name}</span>
                )}
                <span class="d">{p.url ? displayUrl(p.url) : p.tagline}</span>
              </span>
              <span class={`st st-${p.status}`}>{statusLabel[p.status]}</span>
            </li>
          ))
        }
      </ul>
      {
        features.now && (
          <p class="nowline">
            <b>Now:</b>
            {now.summary}
            <a href="/now/">Updated {now.updated}</a>.
          </p>
        )
      }
    </section>
  </div>
</MainLayout>
