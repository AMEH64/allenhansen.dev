---
// A review page for picking the About photo look. Not linked, not indexed, and not in the
// sitemap; delete it (and the unused variants) once one is chosen.
import { SITE_TITLE } from '~/consts'
import PageTitle from '~/components/page-title.astro'
import PhotoPlate from '~/components/photo-plate.astro'
import PhotoStack from '~/components/photo-stack.astro'
import MainLayout from '~/layouts/main-layout.astro'
import portrait from '~/assets/images/allen/allen-portrait.jpg'
import bobaWide from '~/assets/images/boba/boba-wide.jpg'

const variants = [
  {
    key: 'a',
    name: 'Tinted polaroids',
    note: 'Square prints on ink-washed stock, a deeper bottom strip with the caption in mono, a soft drop shadow.',
  },
  {
    key: 'b',
    name: 'Polaroids with a glass sheen',
    note: 'The same prints, with a glossy edge and a soft highlight on the top one. No blur.',
  },
  {
    key: 'c',
    name: 'Plain square prints',
    note: 'Borderless tinted photos with square corners, closest to the iMessage pile.',
  },
] as const
---

<MainLayout
  title={`Photo stack variants · ${SITE_TITLE}`}
  description="Four looks for the About page photos, side by side."
  noindex
>
  <PageTitle
    title="Photo stack"
    slug="lab / photo-stack"
    lead="Four looks for the About photos. A to C are stacks that work the same way: drag or swipe the top print away, click or tap it, or use the arrow keys. D is two still plates."
  />
  <div class="lab-grid">
    {
      variants.map(v => (
        <section class="lab-variant" aria-labelledby={`lab-${v.key}`}>
          <h2 id={`lab-${v.key}`}>
            <span>{v.key.toUpperCase()}</span> {v.name}
          </h2>
          <p>{v.note}</p>
          <PhotoStack
            variant={v.key}
            id={`pile-${v.key}`}
            label={`Variant ${v.key.toUpperCase()}: Boba and me`}
          />
        </section>
      ))
    }
  </div>
  <section class="lab-variant lab-d" aria-labelledby="lab-d">
    <h2 id="lab-d"><span>D</span> Two editorial plates</h2>
    <p>
      No stack and no JS: a modest portrait beside the About opener, and Boba
      full width between the About sections. <a href="/lab/about-plates/"
        >See D in place on the About page →</a
      >
    </p>
    <div class="lab-d-plates">
      <PhotoPlate
        src={portrait}
        alt="Allen smiling in glasses and a light linen shirt, with trees softly out of focus behind him."
        plate="I"
        caption="Allen Hansen"
        shape="portrait"
      />
      <PhotoPlate
        src={bobaWide}
        alt="Allen sits in the grass with an arm around Boba, a black dog with a white chest and a collar, and smiles down at him."
        plate="II"
        caption="Boba and me"
        shape="wide"
      />
    </div>
  </section>
</MainLayout>
