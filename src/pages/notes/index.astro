---
import { SITE_TITLE } from '~/consts'
import NoteRow from '~/components/note-row.astro'
import PageTitle from '~/components/page-title.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { getNotes, type Note } from '~/lib/notes'
import { meta, notesConfig } from '~/site.config'

const notes = await getNotes()
const years = Object.entries(
  notes.reduce<Record<string, Note[]>>((acc, note) => {
    ;(acc[note.data.date.slice(0, 4)] ||= []).push(note)
    return acc
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a))

const months =
  notesConfig.recheckMonths === 12
    ? 'a year'
    : `${notesConfig.recheckMonths} months`
---

<MainLayout
  title={`Notes · ${SITE_TITLE}`}
  description={meta.notes}
  ogImage="/og/notes.png"
  current="notes"
>
  <PageTitle
    title="Notes"
    lead={`Short notes on what I’ve learned. Each says when I last checked it, and one that hasn’t been checked in ${months} says so. Stories just say when I wrote them.`}
  />
  {
    years.map(([year, list]) => (
      <section class="year" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`}>{year}</h2>
        <ul class="rows">
          {list.map(note => (
            <NoteRow note={note} />
          ))}
        </ul>
      </section>
    ))
  }
  <div style="height:40px"></div>
</MainLayout>
