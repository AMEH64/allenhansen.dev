---
// One black-and-white photo with the ink laid over at low strength, square corners, and an
// optional mono caption. No JS. Captions never name a place.
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Props = {
  src: ImageMetadata
  alt: string
  caption?: string
  /** portrait sits beside the About opener; wide runs the full width between sections. */
  shape: 'portrait' | 'wide'
}
const { src, alt, caption, shape } = Astro.props
const wide = shape === 'wide'
const Tag = caption ? 'figure' : 'div'
---

<Tag
  class:list={[
    'plate',
    wide ? 'mt-24 mb-64 phone:mt-8 phone:mb-44' : 'max-w-260 phone:max-w-240',
  ]}
>
  <div
    class="relative isolate overflow-hidden bg-press ring-1 ring-rule after:pointer-events-none after:absolute after:inset-0 after:bg-(--tint) after:opacity-26 after:mix-blend-color forced-colors:after:hidden"
  >
    <Image
      class:list={[
        'block h-auto w-full object-cover filter-[grayscale(1)_contrast(1.06)]',
        wide ? 'aspect-[12/5] phone:aspect-[3/2]' : 'aspect-[4/5]',
      ]}
      src={src}
      alt={alt}
      widths={wide ? [720, 1280, 1920, 2400] : [280, 480, 720]}
      sizes={wide
        ? '(max-width: 760px) calc(100vw - 40px), 1180px'
        : '(max-width: 760px) 240px, 260px'}
      format="webp"
      quality={72}
      loading={wide ? 'lazy' : 'eager'}
      decoding="async"
    />
  </div>
  {
    caption && (
      <figcaption class="mt-12 font-mono text-[12px] tracking-[0.04em] text-muted">
        {caption}
      </figcaption>
    )
  }
</Tag>
