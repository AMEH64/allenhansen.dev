---
// One black-and-white photo with the ink laid over at low strength, square corners, and an
// optional mono caption. No JS. Captions never name a place.
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Props = {
  src: ImageMetadata
  alt: string
  caption?: string
  /** portrait sits in the About sidebar; wide runs the full width between sections. */
  shape: 'portrait' | 'wide'
  loading?: 'eager' | 'lazy'
  class?: string
  /** Extra image classes, e.g. an object position for where the crop falls. */
  imageClass?: string
  /** Overrides the shape's sizes when the frame is narrower than the shape assumes. */
  sizes?: string
}
const { src, alt, caption, shape, class: className, imageClass } = Astro.props
const wide = shape === 'wide'
const loading = Astro.props.loading ?? (wide ? 'lazy' : 'eager')
const widths = wide ? [720, 1280, 1920, 2400] : [280, 480, 720]
const Tag = caption ? 'figure' : 'div'
---

<Tag
  class:list={[
    wide ? 'mt-6 mb-16 phone:mt-2 phone:mb-11' : 'max-w-65 phone:max-w-60',
    className,
  ]}
>
  <div
    class="relative isolate overflow-hidden bg-press ring-1 ring-rule after:pointer-events-none after:absolute after:inset-0 after:bg-(--tint) after:opacity-26 after:mix-blend-color forced-colors:after:hidden"
  >
    <Image
      class:list={[
        'block h-auto w-full object-cover filter-[grayscale(1)_contrast(1.06)]',
        wide ? 'aspect-[12/5] phone:aspect-[3/2]' : 'aspect-[4/5]',
        imageClass,
      ]}
      src={src}
      alt={alt}
      width={Math.min(src.width, widths.at(-1)!)}
      widths={widths}
      sizes={Astro.props.sizes ??
        (wide
          ? '(max-width: 760px) calc(100vw - 40px), 1180px'
          : '(max-width: 760px) 240px, 260px')}
      format="webp"
      quality={72}
      loading={loading}
      decoding="async"
    />
  </div>
  {
    caption && (
      <figcaption class="mt-3 font-mono text-[12px] tracking-[0.04em] text-muted">
        {caption}
      </figcaption>
    )
  }
</Tag>
