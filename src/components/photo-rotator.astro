---
// Boba and me: black-and-white photos with the brand ink laid over at low strength.
// Only the first photo loads with the page; each later one gets its src just before it shows.
// Without JS the first photo shows alone and the controls stay hidden.
import { getImage } from 'astro:assets'
import boba1 from '~/assets/images/boba/boba-1.jpg'
import boba2 from '~/assets/images/boba/boba-2.jpg'
import boba3 from '~/assets/images/boba/boba-3.jpg'

const photos = [
  {
    src: boba1,
    alt: 'Boba, a black dog with a grey muzzle and a red collar, sits up tall on a stone wall while Allen leans in and smiles down at him.',
  },
  {
    src: boba2,
    alt: 'Allen sits on a stone wall in a park with an arm around Boba, smiling; Boba sits beside him in a red collar.',
  },
  {
    src: boba3,
    alt: 'Allen and Boba sit side by side on a stone wall in a park, both facing the camera.',
  },
]
const ROMAN = ['I', 'II', 'III', 'IV', 'V']
const sizes = '(max-width: 760px) 260px, 300px'

const images = await Promise.all(
  photos.map(async p => {
    const img = await getImage({
      src: p.src,
      widths: [320, 640, 960],
      width: 640,
      height: 800,
      format: 'webp',
      quality: 72,
    })
    return { ...p, url: img.src, srcset: img.srcSet.attribute }
  }),
)
---

<section
  class="rotator"
  data-rotator
  aria-roledescription="carousel"
  aria-label="Photos of Boba and me"
>
  <figure class="rot-fig">
    <div class="rot-frame">
      {
        images.map((img, i) =>
          i === 0 ? (
            <img
              class="rot-slide is-current"
              src={img.url}
              srcset={img.srcset}
              sizes={sizes}
              width="640"
              height="800"
              alt={img.alt}
              decoding="async"
            />
          ) : (
            <img
              class="rot-slide"
              data-src={img.url}
              data-srcset={img.srcset}
              sizes={sizes}
              width="640"
              height="800"
              alt={img.alt}
              decoding="async"
              aria-hidden="true"
            />
          ),
        )
      }
    </div>
    <figcaption>
      <span>Boba and me</span>
      <span class="rot-count" aria-hidden="true"
        >Plate I of {ROMAN[photos.length - 1]}</span
      >
    </figcaption>
  </figure>
  <div class="rot-ctrl" data-rot-ctrl hidden>
    <button type="button" data-rot-prev aria-label="Previous photo"
      ><span aria-hidden="true">←</span></button
    >
    <button type="button" class="rot-toggle" data-rot-toggle
      ><span class="ico" aria-hidden="true">❚❚</span>
      <span class="lbl">Pause</span></button
    >
    <button type="button" data-rot-next aria-label="Next photo"
      ><span aria-hidden="true">→</span></button
    >
  </div>
  <p class="vh" data-rot-status aria-live="polite"></p>
</section>

<script>
  // Crossfades every 5.5 s. Pauses on hover, on focus, offscreen, and in a hidden tab, and has a
  // visible Pause/Play button. Reduced motion: no autoplay; Previous and Next still work.
  const DWELL = 5500
  const ROMAN = ['I', 'II', 'III', 'IV', 'V']
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')

  const load = (img: HTMLImageElement) => {
    if (img.dataset.src) {
      img.srcset = img.dataset.srcset ?? ''
      img.src = img.dataset.src
      delete img.dataset.src
      delete img.dataset.srcset
    }
  }
  const ready = (img: HTMLImageElement) => img.complete && img.naturalWidth > 0

  function init(root: HTMLElement) {
    const slides = [...root.querySelectorAll<HTMLImageElement>('.rot-slide')]
    const n = slides.length
    if (n < 2) return
    const toggle = root.querySelector<HTMLButtonElement>('[data-rot-toggle]')!
    const status = root.querySelector('[data-rot-status]')!
    const count = root.querySelector('.rot-count')!
    let i = 0
    let timer = 0
    let userPaused = reduce.matches
    let hover = false
    let focus = false
    let onscreen = true

    root.querySelector<HTMLElement>('[data-rot-ctrl]')!.hidden = false
    const setToggle = () => {
      toggle.querySelector('.lbl')!.textContent = userPaused ? 'Play' : 'Pause'
      toggle.querySelector('.ico')!.textContent = userPaused ? '▶' : '❚❚'
    }
    const running = () =>
      !userPaused && !hover && !focus && onscreen && !document.hidden
    const schedule = () => {
      clearTimeout(timer)
      if (!running()) return
      load(slides[(i + 1) % n])
      timer = window.setTimeout(() => show(i + 1, false), DWELL)
    }
    function show(to: number, announce: boolean) {
      const next = (to + n) % n
      const img = slides[next]
      load(img)
      const swap = () => {
        slides.forEach((s, k) => {
          s.classList.toggle('is-current', k === next)
          if (k === next) s.removeAttribute('aria-hidden')
          else s.setAttribute('aria-hidden', 'true')
        })
        i = next
        count.textContent = `Plate ${ROMAN[i]} of ${ROMAN[n - 1]}`
        if (announce) status.textContent = `Photo ${i + 1} of ${n}: ${img.alt}`
        schedule()
      }
      if (ready(img)) swap()
      else img.addEventListener('load', swap, { once: true })
    }

    root
      .querySelector('[data-rot-prev]')!
      .addEventListener('click', () => show(i - 1, true))
    root
      .querySelector('[data-rot-next]')!
      .addEventListener('click', () => show(i + 1, true))
    // Pressing Play is explicit, so it overrides the focus pause (the click just focused the button).
    toggle.addEventListener('click', () => {
      userPaused = !userPaused
      if (!userPaused) focus = false
      setToggle()
      schedule()
    })
    root.addEventListener('pointerenter', e => {
      if (e.pointerType === 'mouse') {
        hover = true
        schedule()
      }
    })
    root.addEventListener('pointerleave', () => {
      hover = false
      schedule()
    })
    root.addEventListener('focusin', () => {
      focus = true
      schedule()
    })
    root.addEventListener('focusout', e => {
      if (!root.contains(e.relatedTarget as Node | null)) {
        focus = false
        schedule()
      }
    })
    document.addEventListener('visibilitychange', schedule)
    reduce.addEventListener('change', () => {
      if (reduce.matches) {
        userPaused = true
        setToggle()
      }
      schedule()
    })
    new IntersectionObserver(entries => {
      onscreen = entries[0].isIntersecting
      schedule()
    }).observe(root)
    setToggle()
    schedule()
  }

  document.querySelectorAll<HTMLElement>('[data-rotator]').forEach(init)
</script>
