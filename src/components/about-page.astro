---
import { SITE_TITLE } from '~/consts'
import PageTitle from '~/components/page-title.astro'
import PhotoStack from '~/components/photo-stack.astro'
import MainLayout from '~/layouts/main-layout.astro'
import { links, meta, yearsInWords } from '~/site.config'
---

<MainLayout
  title={`About · ${SITE_TITLE}`}
  description={meta.about}
  ogImage="/og/about.png"
  current="about"
>
  <PageTitle title="About" />
  <div class="about">
    <div class="prose">
      <p class="lede">I’m Allen Hansen, a senior full-stack engineer.</p>
      <p>
        For {yearsInWords} years I’ve made web apps faster, more accessible, and easier
        to change: Web Forms to React and Angular, WCAG 2.1 AA, theming and design
        systems. Lately it’s Python, FastAPI, and AI tooling.
      </p>
      <p>
        Outside work I’m learning Mandarin and <span lang="haw"
          >ʻŌlelo Hawaiʻi</span
        >, the second through hula. That’s how <a
          href="https://verso.allenhansen.dev">Verso</a
        > happened: I wanted better flash cards.
      </p>
      <p>
        This site is where I write down what I learn. Notes are short and dated,
        and I re-check them; when one turns out wrong, I correct it in the open.
      </p>
      <ul class="contact" aria-label="Contact and elsewhere">
        <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
        <li><a href={links.github}>GitHub</a></li>
        <li><a href={links.linkedin}>LinkedIn</a></li>
        <li><a href="/notes/rss.xml">RSS</a></li>
        <li><a href="/resume/">Résumé</a></li>
      </ul>
    </div>
    <div class="about-side">
      <PhotoStack variant="a" />
      <section class="glance" aria-labelledby="glance-h">
        <h2 id="glance-h">At a glance</h2>
        <dl>
          <div><dt>Role</dt><dd>Senior full-stack engineer</dd></div>
          <div>
            <dt>Now</dt><dd>Schneider Electric Sustainability Business</dd>
          </div>
          <div><dt>Since</dt><dd>2017, from Web Forms to React</dd></div>
          <div><dt>Lately</dt><dd>Python, FastAPI, MCP</dd></div>
          <div>
            <dt>More</dt><dd><a href="/resume/">The full résumé →</a></dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
  <section class="colophon" aria-label="Colophon">
    <span class="rule"></span>
    <div>
      <h2>The press</h2>
      <p>
        Headings are printed blind into the stock. A lamp rakes across them; on
        phones it follows your scroll.
      </p>
    </div>
    <div>
      <h2>Readable first</h2>
      <p>
        Body type is Atkinson Hyperlegible, designed for low vision. Reduced
        motion parks the lamp.
      </p>
    </div>
    <div>
      <h2>Notes stay honest</h2>
      <p>
        Every note says when I last checked it, with a dated change log at the
        foot. Real mistakes are struck through and corrected in the text.
      </p>
    </div>
  </section>
</MainLayout>
