---
import type { FreshnessState } from '~/lib/notes'

// `href` points "Updated …" at the change log; the other states are plain text.
type Props = { state: FreshnessState; label: string; href?: string }
const { state, label, href } = Astro.props
---

<span class={`mark m-${state}`}
  ><i aria-hidden="true"></i>{
    href && state === 'updated' ? <a href={href}>{label}</a> : label
  }</span
>
