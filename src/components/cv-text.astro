---
import Anchor from './mdx/anchor.astro'

// A résumé bullet: plain text with optional [text](https://…) links.
type Props = { text: string }
const parts = Astro.props.text.split(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/)
const bare = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')
---

{
  parts.map((part, i) =>
    i % 3 === 0 ? (
      part
    ) : i % 3 === 1 ? (
      <Anchor href={parts[i + 1]} data-print-url={bare(parts[i + 1]!)}>
        {part}
      </Anchor>
    ) : null,
  )
}
