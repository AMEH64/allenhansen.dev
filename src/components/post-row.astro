---
import { formatDate } from '~/lib/dates'
import { typeLabel, postPath, type Post } from '~/lib/posts'
import { postType, row, rowDesc, rowTitle } from '~/lib/classes'
import PostTags from './post-tags.astro'

type Props = { note: Post }
const { note } = Astro.props
const { data } = note
---

<li
  class:list={[row, 'grid-cols-[110px_1fr] phone:grid-cols-[1fr]']}
  data-post
  data-type={data.type}
  data-tags={data.tags.join(' ')}
>
  <time class="text-[13px] text-muted tabular-nums" datetime={data.date}
    >{formatDate(data.date)}</time
  >
  <span>
    <a class={rowTitle} href={postPath(note.id)}>{data.title}</a>
    <span class={rowDesc}>{data.summary}</span>
    <span class="mt-7 flex flex-wrap items-baseline gap-x-12 gap-y-4">
      <span class={postType}>{typeLabel[data.type]}</span>
      <PostTags tags={data.tags} />
    </span>
  </span>
</li>
