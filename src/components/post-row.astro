---
import { formatDate } from '~/lib/dates'
import { typeLabel, postPath, type Post } from '~/lib/posts'

type Props = { note: Post }
const { note } = Astro.props
const href = postPath(note.id)
---

<li>
  <time datetime={note.data.date}>{formatDate(note.data.date)}</time>
  <span>
    <a class="t" href={href}>{note.data.title}</a>
    <span class="d">{note.data.summary}</span>
    <span class="row-meta"
      ><span class="post-type">{typeLabel[note.data.type]}</span></span
    >
  </span>
</li>
