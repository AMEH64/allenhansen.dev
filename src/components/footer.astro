---
import { rssPath } from '~/lib/posts'
import { links } from '~/site.config'

type Props = { current?: string }
const { current } = Astro.props
---

<footer
  class="relative flex justify-between gap-20 pt-32 pb-40 text-[13.5px] text-muted before:absolute before:inset-x-0 before:top-0 before:rule print:in-[.page-resume]:hidden phone:flex-col"
>
  <p>
    © {new Date().getFullYear()} Allen Hansen. Set in Anybody and Atkinson Hyperlegible.
  </p>
  <nav
    class="flex flex-wrap items-center gap-x-20 gap-y-8 *:no-underline after:ml-6 after:size-14 after:registration-mark *:hover:text-text *:hover:underline *:hover:decoration-brand *:hover:decoration-auto *:aria-[current=page]:text-text *:aria-[current=page]:underline *:aria-[current=page]:decoration-brand *:aria-[current=page]:decoration-auto"
    aria-label="Elsewhere"
  >
    <a href={rssPath}>RSS</a>
    <a href={links.github}>GitHub</a>
    <a href={links.linkedin}>LinkedIn</a>
    <a href="/resume/" aria-current={current === 'resume' ? 'page' : undefined}
      >Résumé</a
    >
    <a href={`mailto:${links.email}`}>Email</a>
  </nav>
</footer>
