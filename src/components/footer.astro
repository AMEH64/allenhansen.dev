---
import { rssPath } from '~/lib/posts'
import { links } from '~/site.config'

type Props = { current?: string }
const { current } = Astro.props
---

<footer class="site-foot">
  <p>
    © {new Date().getFullYear()} Allen Hansen. Set in Anybody and Atkinson Hyperlegible.
    One spot ink: ultramarine.
  </p>
  <nav aria-label="Elsewhere">
    <a href={rssPath}>RSS</a>
    <a href={links.github}>GitHub</a>
    <a href={links.linkedin}>LinkedIn</a>
    <a href="/resume/" aria-current={current === 'resume' ? 'page' : undefined}
      >Résumé</a
    >
    <a href={`mailto:${links.email}`}>Email</a>
  </nav>
</footer>
