---
import { features } from '~/config/features'
import { BLOG } from '~/lib/posts'
import ThemeToggle from './theme-toggle.astro'

type Props = { current?: string }
const { current } = Astro.props

const items = (
  [
    ['blog', 'Blog', BLOG, true],
    ['projects', 'Projects', '/projects/', true],
    ['about', 'About', '/about/', features.about],
    ['now', 'Now', '/now/', features.now],
  ] as const
).filter(([, , , on]) => on)
---

<header class="site">
  <a class="logo" href="/">
    <span class="logo-mark" aria-hidden="true"></span><span>Allen Hansen</span>
  </a>
  <nav aria-label="Primary">
    {
      items.map(([key, label, href]) => (
        <a href={href} aria-current={current === key ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
  <ThemeToggle />
</header>
