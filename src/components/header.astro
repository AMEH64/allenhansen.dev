---
import { features } from '~/config/features'
import { BLOG } from '~/lib/posts'
import ThemeToggle from './theme-toggle.astro'

type Props = { current?: string }
const { current } = Astro.props

const items = (
  [
    ['blog', 'Blog', BLOG, true],
    ['projects', 'Projects', '/projects/', true],
    ['about', 'About', '/about/', features.about],
    ['now', 'Now', '/now/', features.now],
  ] as const
).filter(([, , , on]) => on)
---

<header
  class="flex items-center justify-between gap-6 py-7 print:in-[.page-resume]:hidden phone:flex-wrap phone:gap-x-5 phone:gap-y-3 phone:py-[18px]"
>
  <a
    class="inline-flex items-center gap-[9px] font-display text-[14.5px] leading-none font-extrabold tracking-[0.02em] uppercase no-underline [font-variation-settings:'wdth'_104] phone:text-[13.5px]"
    href="/"
  >
    <span
      class="size-[11px] flex-none bg-brand forced-colors:bg-[CanvasText]"
      aria-hidden="true"></span><span>Allen Hansen</span>
  </a>
  <nav
    class="ml-auto flex items-center gap-[30px] text-[15px] phone:order-3 phone:ml-0 phone:basis-full phone:gap-[22px] phone:text-[14.5px]"
    aria-label="Primary"
  >
    {
      items.map(([key, label, href]) => (
        <a
          class="text-muted no-underline hover:text-text aria-[current=page]:text-text aria-[current=page]:underline aria-[current=page]:decoration-brand aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[0.4em]"
          href={href}
          aria-current={current === key ? 'page' : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
  <ThemeToggle />
</header>
