---
import { formatDate } from '~/lib/dates'
import { kindLabel, type Note } from '~/lib/notes'

type Props = { note: Note }
const { note } = Astro.props
const href = `/notes/${note.id}/`
---

<li>
  <time datetime={note.data.date}>{formatDate(note.data.date)}</time>
  <span>
    <a class="t" href={href}>{note.data.title}</a>
    <span class="d">{note.data.summary}</span>
    <span class="row-meta"
      ><span class="kind">{kindLabel[note.data.kind]}</span></span
    >
  </span>
</li>
