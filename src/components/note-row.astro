---
import { formatDate } from '~/lib/dates'
import { freshness, type Note } from '~/lib/notes'
import Freshness from './freshness.astro'

type Props = { note: Note }
const { note } = Astro.props
const f = freshness(note.data)
---

<li>
  <time datetime={note.data.pubDate}>{formatDate(note.data.pubDate)}</time>
  <span>
    <a class="t" href={`/notes/${note.id}/`}>{note.data.title}</a>
    <span class="d">{note.data.description}</span>
  </span>
  <Freshness state={f.state} label={f.label} />
</li>
