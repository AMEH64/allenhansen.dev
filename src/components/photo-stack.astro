---
// Boba and me: a pile of black-and-white prints with the brand ink laid over at low strength.
// Drag or swipe the top print away and it tucks in at the back; click, tap, or press ←/→ to
// cycle. Nothing moves on its own. Without JS the pile is a still picture and the controls
// stay hidden. To add a photo, put it in src/assets/images/boba/ and add it to `photos`.
import { getImage } from 'astro:assets'
import boba1 from '~/assets/images/boba/boba-1.jpg'
import boba2 from '~/assets/images/boba/boba-2.jpg'
import boba3 from '~/assets/images/boba/boba-3.jpg'

const photos = [
  {
    src: boba1,
    alt: 'Boba, a black dog with a grey muzzle and a red collar, sits up tall on a stone wall while Allen leans in and smiles down at him.',
  },
  {
    src: boba2,
    alt: 'Allen sits on a stone wall in a park with an arm around Boba, smiling; Boba sits beside him in a red collar.',
  },
  {
    src: boba3,
    alt: 'Allen and Boba sit side by side on a stone wall in a park, both facing the camera.',
  },
]
const sizes = '(max-width: 760px) 248px, 288px'
// Prints deeper than this sit hidden under the last visible one.
const VISIBLE = 4

const images = await Promise.all(
  photos.map(async p => {
    const img = await getImage({
      src: p.src,
      widths: [320, 640, 960],
      width: 640,
      height: 800,
      format: 'webp',
      quality: 72,
    })
    return { ...p, url: img.src, srcset: img.srcSet.attribute }
  }),
)

const roman = (n: number) => {
  let out = ''
  for (const [sym, val] of [
    ['X', 10],
    ['IX', 9],
    ['V', 5],
    ['IV', 4],
    ['I', 1],
  ] as const) {
    while (n >= val) {
      out += sym
      n -= val
    }
  }
  return out
}
---

<section class="pile" data-pile aria-labelledby="pile-cap">
  <figure class="pile-fig">
    <div class="pile-stack" data-pile-stack data-visible={VISIBLE}>
      {
        images.map((img, i) => (
          <div
            class="pile-card"
            data-pos={i < VISIBLE ? i : 'far'}
            aria-hidden={i > 0 ? 'true' : undefined}
          >
            <img
              src={img.url}
              srcset={img.srcset}
              sizes={sizes}
              width="640"
              height="800"
              alt={img.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </div>
        ))
      }
    </div>
    <figcaption>
      <span id="pile-cap">Boba and me</span>
      <span class="pile-count" aria-hidden="true"
        >Plate I of {roman(images.length)}</span
      >
    </figcaption>
  </figure>
  <div class="pile-ctrl" data-pile-ctrl hidden>
    <button type="button" data-pile-prev aria-label="Previous photo"
      ><span aria-hidden="true">←</span></button
    >
    <button type="button" data-pile-next aria-label="Next photo"
      ><span aria-hidden="true">→</span></button
    >
    <span class="pile-hint" id="pile-hint"
      >Drag, tap, or use the arrow keys</span
    >
  </div>
  <p class="vh" data-pile-status aria-live="polite"></p>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)')
  // Matches the .pile-card transition in press.css.
  const FLING_MS = 230
  const TAP_PX = 6

  const roman = (n: number) => {
    let out = ''
    for (const [sym, val] of [
      ['X', 10],
      ['IX', 9],
      ['V', 5],
      ['IV', 4],
      ['I', 1],
    ] as const) {
      while (n >= val) {
        out += sym
        n -= val
      }
    }
    return out
  }

  function init(root: HTMLElement) {
    const stack = root.querySelector<HTMLElement>('[data-pile-stack]')!
    const cards = [...stack.querySelectorAll<HTMLElement>('.pile-card')]
    const n = cards.length
    if (n < 2) return
    const visible = Number(stack.dataset.visible) || 4
    const status = root.querySelector('[data-pile-status]')!
    const count = root.querySelector('.pile-count')!
    const alts = cards.map(c => c.querySelector('img')!.alt)
    // order[0] is the print on top; values are indexes into `cards`.
    let order = cards.map((_, i) => i)
    let busy = false

    root.querySelector<HTMLElement>('[data-pile-ctrl]')!.hidden = false
    root.classList.add('is-live')
    stack.tabIndex = 0
    stack.setAttribute('role', 'group')
    stack.setAttribute('aria-roledescription', 'photo stack')
    stack.setAttribute('aria-label', 'Photos of Boba and me')
    stack.setAttribute('aria-describedby', 'pile-hint')

    const layout = (skip?: HTMLElement) => {
      order.forEach((card, pos) => {
        const el = cards[card]
        if (el === skip) return
        el.dataset.pos = pos < visible ? String(pos) : 'far'
        if (pos === 0) el.removeAttribute('aria-hidden')
        else el.setAttribute('aria-hidden', 'true')
      })
    }
    const announce = () => {
      const top = order[0]
      count.textContent = `Plate ${roman(top + 1)} of ${roman(n)}`
      status.textContent = `Photo ${top + 1} of ${n}: ${alts[top]}`
    }
    const width = () => stack.getBoundingClientRect().width

    // Send the top print off in direction (dx, dy), then tuck it in at the back.
    function next(dx = 1, dy = -0.15) {
      if (busy) return
      const el = cards[order[0]]
      order = [...order.slice(1), order[0]]
      if (reduce.matches) {
        el.style.transform = ''
        layout()
        announce()
        return
      }
      busy = true
      const len = Math.hypot(dx, dy) || 1
      const reach = width() * 0.9
      el.classList.remove('is-dragging')
      el.dataset.pos = 'lift'
      el.style.transform = `translate(${(dx / len) * reach}px, ${(dy / len) * reach}px) rotate(${dx > 0 ? 9 : -9}deg)`
      layout(el)
      window.setTimeout(() => {
        el.style.transform = ''
        layout()
        announce()
        busy = false
      }, FLING_MS)
    }

    // Bring the bottom print back from the left onto the top.
    function prev() {
      if (busy) return
      const card = order[n - 1]
      const el = cards[card]
      order = [card, ...order.slice(0, -1)]
      if (reduce.matches) {
        layout()
        announce()
        return
      }
      el.classList.add('is-dragging')
      el.dataset.pos = 'lift'
      el.style.transform = `translate(${-width() * 0.9}px, -6px) rotate(-9deg)`
      el.getBoundingClientRect()
      el.classList.remove('is-dragging')
      el.style.transform = ''
      layout()
      announce()
    }

    root
      .querySelector('[data-pile-next]')!
      .addEventListener('click', () => next())
    root.querySelector('[data-pile-prev]')!.addEventListener('click', prev)
    stack.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight' || e.key === 'Enter' || e.key === ' ') next()
      else if (e.key === 'ArrowLeft') prev()
      else return
      e.preventDefault()
    })

    // Drag (mouse) and swipe (touch, horizontal; vertical stays page scroll).
    let drag: {
      id: number
      x: number
      y: number
      t: number
      lastX: number
      lastY: number
      lastT: number
      vx: number
      vy: number
    } | null = null
    const top = () => cards[order[0]]

    stack.addEventListener('pointerdown', e => {
      if (busy || e.button !== 0) return
      const now = performance.now()
      drag = {
        id: e.pointerId,
        x: e.clientX,
        y: e.clientY,
        t: now,
        lastX: e.clientX,
        lastY: e.clientY,
        lastT: now,
        vx: 0,
        vy: 0,
      }
      stack.setPointerCapture(e.pointerId)
      top().classList.add('is-dragging')
      root.classList.add('is-grabbing')
    })
    stack.addEventListener('pointermove', e => {
      if (!drag || e.pointerId !== drag.id) return
      const now = performance.now()
      const dt = Math.max(1, now - drag.lastT)
      drag.vx = (e.clientX - drag.lastX) / dt
      drag.vy = (e.clientY - drag.lastY) / dt
      drag.lastX = e.clientX
      drag.lastY = e.clientY
      drag.lastT = now
      const dx = e.clientX - drag.x
      const dy = e.clientY - drag.y
      top().style.transform = `translate(${dx}px, ${dy}px) rotate(${-1.5 + dx * 0.05}deg)`
    })
    const end = (e: PointerEvent, cancelled: boolean) => {
      if (!drag || e.pointerId !== drag.id) return
      const d = drag
      drag = null
      root.classList.remove('is-grabbing')
      const el = top()
      el.classList.remove('is-dragging')
      const dx = e.clientX - d.x
      const dy = e.clientY - d.y
      const dist = Math.hypot(dx, dy)
      const speed = Math.hypot(d.vx, d.vy)
      if (cancelled) {
        el.style.transform = ''
      } else if (dist < TAP_PX && performance.now() - d.t < 500) {
        next()
      } else if (dist > width() * 0.28 || (speed > 0.45 && dist > 24)) {
        next(dx, dy)
      } else {
        el.style.transform = ''
      }
    }
    stack.addEventListener('pointerup', e => end(e, false))
    stack.addEventListener('pointercancel', e => end(e, true))
  }

  document.querySelectorAll<HTMLElement>('[data-pile]').forEach(init)
</script>
