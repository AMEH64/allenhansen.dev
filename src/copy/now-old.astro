---
// Now copy before the October 2026 rewrite. Pick it with features.nowCopy = 'old'.
import Anchor from '~/components/mdx/anchor.astro'
---

<div class="now-grid">
  <section aria-labelledby="now-work">
    <span class="rule"></span>
    <h2 id="now-work">Working on</h2>
    <div class="prose">
      <ul>
        <li>
          Building and shipping features on a production web application at my
          day job
        </li>
        <li>
          This site: rebuilt as a letterpress proof sheet, with notes that say
          when I last checked them
        </li>
      </ul>
    </div>
  </section>
  <section aria-labelledby="now-learning">
    <span class="rule"></span>
    <h2 id="now-learning">Learning</h2>
    <div class="prose">
      <ul>
        <li>Mandarin, drilling HSK 3 in Verso</li>
        <li>
          <span lang="haw">ʻŌlelo Hawaiʻi</span>, through hula vocabulary
        </li>
        <li>Python, FastAPI, and the Model Context Protocol</li>
      </ul>
    </div>
  </section>
  <section aria-labelledby="now-reading">
    <span class="rule"></span>
    <h2 id="now-reading">Reading &amp; watching</h2>
    <div class="prose">
      <ul>
        <li><em>A Philosophy of Software Design</em>, John Ousterhout</li>
        <li>
          Conference talks on TypeScript compiler internals and performance
        </li>
      </ul>
    </div>
  </section>
  <section aria-labelledby="now-side">
    <span class="rule"></span>
    <h2 id="now-side">Side projects</h2>
    <div class="prose">
      <ul>
        <li>
          <Anchor href="https://verso.allenhansen.dev">Verso</Anchor>: flash
          cards for Chinese and <span lang="haw">ʻŌlelo Hawaiʻi</span>
        </li>
        <li>This site: the design, content, and tooling are ongoing work</li>
      </ul>
    </div>
  </section>
</div>
