---
// Now copy drafted in October 2026. Pick it with features.nowCopy = 'new'.
// The home "Now" line and the page description switch with it, in site.config.ts.
import Anchor from '~/components/mdx/anchor.astro'
---

<div class="now-grid">
  <section aria-labelledby="now-work">
    <span class="rule"></span>
    <h2 id="now-work">Working on</h2>
    <div class="prose">
      <ul>
        {
          /* Open question: is it fine to name Resource Advisor+ in public? If not: "AI features in Schneider Electric’s sustainability software." */
        }
        <li>
          AI features in Resource Advisor+ at Schneider Electric, so people can
          get their work done in the app faster.
        </li>
        {
          /* Open question: are Python, FastAPI, and MCP still a current focus? */
        }
        <li>
          Going deeper on Python, FastAPI, and the Model Context Protocol.
        </li>
      </ul>
    </div>
  </section>
  <section aria-labelledby="now-side">
    <span class="rule"></span>
    <h2 id="now-side">Side projects</h2>
    <div class="prose">
      <ul>
        {
          /* Open question: will verso.allenhansen.dev be live when this ships? */
        }
        <li>
          <Anchor href="https://verso.allenhansen.dev">Verso</Anchor>, a
          flash-card app for learning languages.
        </li>
        <li>This site.</li>
      </ul>
    </div>
  </section>
</div>
<p class="now-away">Away from work: walks with Boba.</p>
